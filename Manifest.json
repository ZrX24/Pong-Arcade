{
  "manifest_version": 3,
  "name": "Pong Arcade",
  "version": "1.0.0",
  "description": "Classic Pong arcade game rebuilt as a Chrome Extension.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Play Pong"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
